# BOOT Patcher Configuration
## Everything after ' ' or '#' is ignored
LIVEQUE=true # Execute the commands immediately upon parsing, does not apply to patch chains (LV0_KSP,_DAT,_EXE)
ERRBREAK=true # Stop execution if any of the following commands fail

# MNTINIT=mnt0,emmc,vtrm,ina
MNTINIT=mnt0,gcsd,entire

## Initialize SPL
ERRBREAK=false
SPLINIT=mnt0:spl_ussm.self # Custom ussm
SPLINIT=os0:spl_ussm.self # HFW ussm
ERRBREAK=true
SPLINIT=os0:/sm/update_service_sm.self # If custom/hfw wasnt found, try default

## Dump (SPL init dropped the firewall)
M_ALLOC=0xF0000000,uc,0x00200000,0x40000000 # alloc a blob in secure dram
FILERW=mnt0:/tz.bin,0xF0000000,0x00200000 # write the TZ blob to gcsd
M_FREE=0xF0000000