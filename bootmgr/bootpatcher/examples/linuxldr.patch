# BOOT Patcher Configuration
## Everything after ' ' or '#' is ignored
LIVEQUE=true # Execute the commands immediately upon parsing, does not apply to patch chains (LV0_KSP,_DAT,_EXE)
ERRBREAK=true # Stop execution if any of the following commands fail

## We store bob, alice in tm0
# MNTINIT=mnt0,emmc,vtrm,ina
MNTINIT=mnt0,gcsd,entire

## Initialize SPL
ERRBREAK=false
LV0INIT=mnt0:spl_ussm.self # Custom ussm
LV0INIT=os0:spl_ussm.self # HFW ussm
ERRBREAK=true
LV0INIT=os0:/sm/update_service_sm.self # If custom/hfw wasnt found, try default

## Load & configure bob
### BOB
LV0_DAT=0x00040000,mnt0:/bob.bin
### Set config (v2) directly in the binary - see bob/config.h for details
LV0_DAT=0x000400D0,0000000000000000 # Framework paddrs - intr & idle
LV0_DAT=0x000400D8,1A310109 # (cfgv2|UART1) | (SetUart) | (useThis|resetTest|intTest) | (uartClk & 0xFF)
LV0_DAT=0x000400DC,E0000400 # test() params pa
### Set custom launch function / "Test" params
LV0_DAT=0x000400E0,FF14AA34 # magic & cfg
LV0_DAT=0x000400E4,C0000400 # s_alice_stopReloadAlice
LV0_DAT=0x000400E8,0400009E # src=0x4F000000 << 1 | setUart=1 << 2 | useDram=0 << 1 | enCS=0
### Init
LV0_EXE=0x000400D0,0x000400B0 # init(&config)

## Read alice
M_ALLOC=0xFF000000,uc,mnt0:/alice.bin,0x4F000000 # uncached PA 0x4F000000, alias to 0xFF000000