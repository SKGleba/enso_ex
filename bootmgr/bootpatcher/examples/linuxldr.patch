# BOOT Patcher Configuration
## Everything after ' ' or '#' is ignored
LIVEQUE=true # Execute the commands immediately upon parsing, does not apply to patch chains (LV0_KSP,_DAT,_EXE)
ERRBREAK=true # Stop execution if any of the following commands fail

## We store bob, alice in tm0
# MNTINIT=mnt0,emmc,vtrm,ina
MNTINIT=mnt0,gcsd,entire

## Initialize SPL
ERRBREAK=false
SPLINIT=mnt0:spl_ussm.self # Custom ussm
SPLINIT=os0:spl_ussm.self # HFW ussm
ERRBREAK=true
SPLINIT=os0:/sm/update_service_sm.self # If custom/hfw wasnt found, try default

## Alloc workbuf & load files
M_ALLOC=0xF0000000,uc,0x00200000,0x4F000000 # 2MiB @ uncached PA 0x4F000000, alias to 0xF0000000
FILERW=0xF0000000,mnt0:/alice.bin,0x00008000 # arm kernel->4F00_0, max 32KiB
FILERW=0xF0008000,mnt0:/regina.bin,0x00001000 # regina->4F00_8000, max 4KiB

## Init bob - see bob/config.h for details
LV0STCK=0x1F860000 # Required since bob can be bigger than SK, assuming we dont fill spad128k
LV0_DAT=0x00040000,mnt0:/bob.bin # bob->priv128K
### initcfg:  mh0 | (mh1|tA1Off|tA0Pos) | uartClk | (uartSet|uart1|resetTest|mb1)
### testf:    alice_stopReloadAlice export idx
### tf_arg0:  src=0x4F000000 << 1 | setUart=1 << 2 | useDram=0 << 1 | enCS=0
LV0_EXE=0xB0B01A99|0x01|0x9E000004,0x000400B0 # init(initcfg, testf, tf_arg0)
