# BOOT Patcher Configuration
## Everything after ' ' or '#' is ignored
LIVEQUE=true # Execute the commands immediately upon parsing

## Initialize SPL
LV0INIT=os0:spl_ussm.self # Try default os0's custom ussm path
ERRBREAK=true # Stop execution if any of the following commands fail
LV0INIT=os0:/sm/update_service_sm.self # If custom wasnt found, try default

## Patch CID keyring's type byte to itu (00)
LV0_KSP=0x0509,0x05,00
KBLPARM=0xA3,00

## Patch out secure_kernel's self checks (0syscall6)
LV0_DAT=0x00804D06,21C500000150

## Allow PSPEMU on devkit +more (qaf)
LV0_KSP=0x050A,0x00,3300000000000F057701001506030303
KBLPARM=0x20,3300000000000F057701001506030303

## Load bob and its components
### Config
LV0_DAT=0x0005BFE0,0000851F00000000 # Framework paddrs - intr & idle
LV0_DAT=0x0005BFE8,1A000101 # UART config - (bus << 24) | clk [0x1001A = 115200/0x1004E = 38400]
LV0_DAT=0x0005BFEC,0100000000000000 # run test()? - false/true/paddr & arg
### BOB
LV0_DAT=0x00040000,os0:/bob.bin
LV0_EXE=0x0005BFE0,0x000400B0
### Misc - load if they exist
ERRBREAK=false # no longer break on fail
LV0_DAT=0x1C100000,os0:/alice.bin # Alice
LV0_DAT=0x0005C000,os0:/brom.bin # Bootrom (for neutered bob vs)